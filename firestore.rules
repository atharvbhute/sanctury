rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
         (request.auth.token.email == "ivikaskhandelwal@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.uid is string &&
             data.email is string &&
             data.email.size() < 100 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() < 50)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() < 500)) &&
             (!('glowColor' in data) || (data.glowColor is string && data.glowColor.size() < 50));
    }

    function isValidProgress(data) {
      return data.uid == request.auth.uid &&
             data.sessionName is string &&
             data.duration is number &&
             data.duration > 0;
    }

    function isValidShadowEntry(data) {
      return data.uid == request.auth.uid &&
             data.title is string &&
             data.title.size() > 0 &&
             data.title.size() < 100 &&
             data.textContent is string &&
             data.textContent.size() > 0 &&
             data.textContent.size() < 5000;
    }

    function isValidJournalEntry(data) {
      return data.uid == request.auth.uid &&
             data.title is string &&
             data.title.size() > 0 &&
             data.title.size() < 100 &&
             data.textContent is string &&
             data.textContent.size() > 0 &&
             data.textContent.size() < 5000 &&
             data.stateBefore is string &&
             data.stateAfter is string &&
             data.createdAt is timestamp;
    }

    // Authorized Users (Whitelist)
    match /authorized_users/{email} {
      allow get: if true; // Necessary for initial whitelist check before auth
      allow update: if isAdmin();
    }

    // User Profiles
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && isValidUser(request.resource.data);
      allow update: if (isOwner(uid) && isValidUser(request.resource.data)) || isAdmin();
    }

    // User Progress Logs
    match /user_progress/{progressId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create: if isAuthenticated() && isValidProgress(request.resource.data);
      allow update, delete: if isAdmin();
    }

    // Journals
    match /journals/{entryId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create: if isOwner(request.resource.data.uid) && isValidJournalEntry(request.resource.data);
      allow update: if isOwner(resource.data.uid) && isValidJournalEntry(request.resource.data);
      allow delete: if isOwner(resource.data.uid) || isAdmin();
    }
  }
}
